// RevTorque Insight の CloudKit スキーマ(コンテナ iCloud.Ryokugyoku.ProjectZD8、プライベートデータベース)
//
// 定義の正はコードです:
//   ProjectZD8/Data/Sync/CloudKit/CloudKitRecordMapper.swift        (RTVehicle / RTMaintenanceRecord / RTPhoto / RTDriveSession)
//   ProjectZD8/Data/Sync/CloudKit/CloudKitArchiveRecordMapper.swift (RTSessionArchive)
// 対応は ProjectZD8Tests/Data/Sync/CloudKit/CloudKitSchemaDefinitionTests.swift が検証します。
//
// 規約: フィールド名はローカル列名と同じ。日時はエポックミリ秒の INT64、真偽値は INT64 の 0/1。
// 子レコードの vehicle は RTVehicle への参照(削除連鎖 deleteSelf はレコード側で指定し、スキーマには現れない)。
// RTSessionArchive は別ゾーンに置くため、車両を参照ではなく文字列 vehicleID で持つ。
// 端末ローカルの列(rawAvailability、deletedAt)は送信しないため含めない。
// ゾーン(RevTorqueInsight / RevTorqueInsightArchives)は実行時にアプリが作るため含めない。
//
// インデックス: 同期は CKSyncEngine のゾーン変更取得と、レコードID指定の取得・保存・削除だけで行い、
// CKQuery を使わないため、QUERYABLE / SORTABLE / SEARCHABLE は付けない。
// GRANT: プライベートデータベース専用のため付けない(公開データベース用の指定)。
//
// このファイルは新しい5つの型だけを持つ。Production には旧版の型が残っており、
// それを含まないスキーマは「型の削除」とみなされ取り込めないため、
// Development から書き出したスキーマへ下の RECORD TYPE 群を追記してから取り込む。

DEFINE SCHEMA

    RECORD TYPE RTVehicle (
        vin                     STRING,
        obdIdentifier           STRING,
        name                    STRING,
        manufacturer            STRING,
        engineModel             STRING,
        powertrain              STRING,
        energySources           STRING,
        tankCapacityLiters      DOUBLE,
        modelYear               INT64,
        note                    STRING,
        photoID                 STRING,
        createdAt               INT64,
        modifiedAt              INT64
    );

    RECORD TYPE RTMaintenanceRecord (
        vehicle                 REFERENCE,
        kind                    STRING,
        title                   STRING,
        performedAt             INT64,
        odometerKilometers      DOUBLE,
        notes                   STRING,
        detail                  BYTES,
        createdAt               INT64,
        modifiedAt              INT64
    );

    RECORD TYPE RTPhoto (
        vehicle                 REFERENCE,
        byteCount               INT64,
        image                   ASSET,
        createdAt               INT64,
        modifiedAt              INT64
    );

    RECORD TYPE RTDriveSession (
        vehicle                 REFERENCE,
        startedAt               INT64,
        endedAt                 INT64,
        endReason               STRING,
        isDemo                  INT64,
        adapterName             STRING,
        adapterTransport        STRING,
        platform                STRING,
        deviceID                STRING,
        deviceName              STRING,
        appVersion              STRING,
        appBuild                STRING,
        pollingPolicyVersion    INT64,
        odometerStartKilometers DOUBLE,
        odometerEndKilometers   DOUBLE,
        distanceSource          STRING,
        sampleCount             INT64,
        respondedCount          INT64,
        payloadByteCount        INT64,
        archiveDigest           STRING,
        modifiedAt              INT64
    );

    RECORD TYPE RTSessionArchive (
        archive                 ASSET,
        archiveDigest           STRING,
        vehicleID               STRING
    );
