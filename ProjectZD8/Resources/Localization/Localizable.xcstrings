    "settings.retention.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raw data already saved to iCloud is removed from this device after this period."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos sin procesar ya guardados en iCloud se eliminan de este dispositivo pasado este periodo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudへ保存済みのRawを、この期間を過ぎるとこの端末から解放します。"
          }
        }
      }
    },
    "settings.retention.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only Raw already saved to iCloud is freed from this device after this period. Anything not yet uploaded is kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se libera de este dispositivo el Raw ya guardado en iCloud tras este periodo. Lo que no se ha subido se conserva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudへ保存済みのRawだけが、この期間を過ぎるとこの端末から解放されます。未保存のものは解放されません。"
          }
        }
      }
    },
