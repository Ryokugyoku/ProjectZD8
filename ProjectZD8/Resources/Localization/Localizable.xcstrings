          "stringUnit" : {
            "state" : "translated",
            "value" : "Un valor alto por sí solo no identifica una falla. Reduzca la carga con seguridad y siga el manual o una inspección profesional."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高値だけで故障とは判断できません。安全に負荷を下げ、車両取扱説明書または専門点検の案内に従ってください。"
          }
        }
      }
    },
    "obd.pid.zd8.21.17.low" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A low value may reflect ambient temperature or warm-up state. Confirm elapsed time and operating conditions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un valor bajo puede reflejar ambiente o calentamiento. Confirme tiempo y condiciones de operación."
