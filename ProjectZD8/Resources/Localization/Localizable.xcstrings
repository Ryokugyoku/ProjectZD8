    "settings.demo.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, a simulated adapter appears and captured sessions are recorded as demo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si se activa, aparece un adaptador simulado y las sesiones se registran como demostración."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にすると模擬アダプターが表示され、取得したセッションはデモとして記録されます。"
          }
        }
      }
    },
    "settings.demo.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo Mode adds a simulated adapter so you can try the app without a vehicle. Demo sessions are labeled DEMO and are not synced to iCloud or used for learning."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo demostración añade un adaptador simulado para probar la app sin vehículo. Las sesiones de demostración se marcan como DEMO y no se sincronizan con iCloud ni se usan para aprender."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デモモードでは模擬アダプターが探索結果に加わり、実車がなくても画面を試せます。デモで取得したログは「DEMO」と表示され、iCloudへの同期や分析の学習には使われません。"
          }
        }
      }
    },
