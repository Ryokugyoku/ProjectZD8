    "sync.erase.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vehicles, maintenance records, photos and drive logs will be deleted from iCloud and every device using this iCloud account. This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán los vehículos, registros de mantenimiento, fotos y registros de conducción de iCloud y de todos los dispositivos con esta cuenta de iCloud. Esta acción no se puede deshacer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "車両・整備記録・写真・走行ログを、iCloudと同じiCloudアカウントの全端末から削除します。この操作は取り消せません。"
          }
        }
      }
    },
