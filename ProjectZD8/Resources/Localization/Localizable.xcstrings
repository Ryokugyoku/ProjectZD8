    "analysis.trend.empty.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A line chart appears when at least one PID can be decoded to numeric values."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El gráfico aparece cuando al menos un PID puede convertirse en valores numéricos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数値へ変換できるPIDがあると折れ線グラフを表示します。"
          }
        }
      }
    },
    "analysis.trend.empty.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No numeric trend available"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay tendencia numérica"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "表示できる数値推移がありません"
          }
        }
      }
    },
    "analysis.trend.guide.codes_cleared_distance" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PID 31 is cumulative distance since trouble codes were cleared. It does not provide the clear date and behavior depends on the ECU."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El PID 31 es distancia desde el borrado. No da la fecha y depende de la ECU."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PID 31は故障コード消去後の累積走行距離です。消去日時は含まず、リセット挙動や対応はECUごとに異なります。"
          }
        }
      }
    },
    "analysis.trend.guide.coolant" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coolant temperature shows warm-up and cooling behavior. Compare similar conditions; one excursion does not identify the failed cooling part."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La temperatura muestra calentamiento y refrigeración. Una variación no identifica la pieza causante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "冷却水温は暖機と冷却挙動を示します。近い条件で比較し、単発変化だけで原因部品を特定しません。"
          }
        }
      }
    },
    "analysis.trend.guide.exhaust_temperature" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catalyst or DPF temperature shows thermal history. It does not quantify soot or prove regeneration or component health."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La temperatura muestra historial térmico. No cuantifica hollín ni demuestra regeneración o estado."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "触媒・DPF温度は熱履歴を示しますが、煤量、再生成否、部品健全性は確定できません。"
          }
        }
      }
    },
    "analysis.trend.guide.fuel_trim" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fuel trim shows ECU mixture correction. Interpretation requires bank layout, closed-loop state, load, temperature, and vehicle limits."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El ajuste muestra corrección de mezcla. Requiere banco, lazo cerrado, carga, temperatura y límites."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "燃料補正はECUの混合気補正です。バンク構成、制御状態、負荷、温度、車種別基準が必要です。"
          }
        }
      }
    },
    "analysis.trend.guide.generic" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This PID records the named value over time. Compare timing, range, and repeated changes with other conditions; do not infer a fault from this series alone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este PID registra el valor indicado. Compare momento, rango y cambios; no deduzca una avería solo con esta serie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "表示名の値を時系列で記録します。変化時刻、範囲、繰り返し方を他条件と比較し、この系列だけで故障を断定しません。"
          }
        }
      }
    },
    "analysis.trend.guide.load" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calculated load is ECU-derived relative load, not measured torque. Compare it with rpm, throttle, airflow, and road conditions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carga calculada es relativa, no par medido. Compárela con rpm, mariposa, aire y condiciones."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "算出負荷はECUが求める相対負荷で、実測トルクではありません。回転数、スロットル、吸入空気量、走行条件と比較します。"
          }
        }
      }
    },
    "analysis.trend.guide.maf" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mass air flow is intake-air mass per second. Compare it with rpm, load, and throttle; conditions, leaks, restriction, contamination, or calibration can affect it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El caudal es masa de aire por segundo. Compárelo con rpm, carga y mariposa; fugas, restricción o sensor pueden afectarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "吸入空気量は1秒あたりの空気質量です。回転数、負荷、スロットルと比較し、漏れ、詰まり、汚れ、校正差も考慮します。"
          }
        }
      }
    },
    "analysis.trend.guide.mil_distance" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PID 21 is cumulative distance traveled while the MIL was on. It does not identify the fault cause or when the lamp came on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El PID 21 es distancia con MIL encendida. No identifica causa ni fecha."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PID 21はMIL点灯中の累積走行距離です。故障原因や点灯開始日時は特定できません。"
          }
        }
      }
    },
    "analysis.trend.guide.odometer" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PID A6 is an ECU-reported odometer. Availability varies and it is not a certified instrument reading."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El PID A6 es odómetro informado por la ECU. Su disponibilidad varía y no es lectura certificada."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PID A6はECUが報告する累積走行距離です。対応は車両ごとに異なり、法定計器の証明値ではありません。"
          }
        }
      }
    },
    "analysis.trend.guide.oil_temperature" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oil temperature shows warm-up and heat exposure. It does not directly measure pressure, level, viscosity, or sludge."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La temperatura muestra calentamiento. No mide directamente presión, nivel, viscosidad ni lodos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "油温は暖機と熱履歴を示しますが、油圧、油量、粘度、スラッジを直接測る値ではありません。"
          }
        }
      }
    },
    "analysis.trend.guide.rpm" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PID 0C is engine speed. It shows rpm ranges, idle, acceleration, and possible shift changes; it does not identify load or gear by itself."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El PID 0C es rpm del motor. Muestra rangos, ralentí y aceleración; no identifica carga ni marcha."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PID 0Cはエンジン回転数です。使用域、アイドリング、加速、変速に伴う変化が見えますが、負荷やギア段は単独で特定できません。"
          }
        }
      }
    },
    "analysis.trend.guide.runtime" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PID 1F is engine run time since the current start, not this app's session duration."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El PID 1F es tiempo desde el arranque, no duración de la sesión."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PID 1Fは現在の始動からのエンジン稼働時間で、アプリの接続時間とは異なります。"
          }
        }
      }
    },
    "analysis.trend.guide.speed" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PID 0D is ECU-reported vehicle speed. It shows stops, cruising, and acceleration; GPS speed can differ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El PID 0D es velocidad informada por la ECU. Muestra paradas y aceleración; puede diferir del GPS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PID 0DはECUが報告する車速です。停車、巡航、加減速が見えます。GPS速度とは差が出る場合があります。"
          }
        }
      }
    },
    "analysis.trend.guide.throttle" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Throttle or pedal PIDs show commanded or measured position. Confirm the name: throttle and accelerator-pedal position are not interchangeable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los PID muestran posición de mariposa o pedal. Confirme el nombre; no son equivalentes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スロットル・ペダルPIDは要求値や実位置です。名称を確認し、スロットル開度とペダル位置を同一視しません。"
          }
        }
      }
    },
    "analysis.trend.guide.voltage" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PID 42 is ECU supply voltage. Compare dips with rpm and electrical load; it is not direct alternator output."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El PID 42 es voltaje visto por la ECU. Compare caídas con rpm y carga; no es salida directa del alternador."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PID 42はECUが見ている電源電圧です。降下を回転数・電装負荷と比較できますが、オルタネータ出力の直接測定ではありません。"
          }
        }
      }
    },
    "analysis.trend.guide.zd8_atf" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ZD8-specific AT fluid temperature is shown only after a response from the transmission ECU. Confirm operating conditions before interpreting it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La temperatura ATF específica de ZD8 aparece solo tras respuesta de la ECU de transmisión. Confirme las condiciones antes de interpretarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ZD8専用AT油温は変速機ECUから応答を確認した場合だけ表示します。値の解釈前に走行条件を確認してください。"
          }
        }
      }
    },
    "analysis.trend.guide.zd8_distance" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ZD8-specific vehicle distance is an ECU-reported cumulative value and is not a certified instrument reading."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La distancia específica de ZD8 es un valor acumulado informado por la ECU, no una lectura certificada."
          }
        },
        "ja" : {
