    "obd.pid.zd8.21.02.correlation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare start and end values within the same session; do not compare unrelated vehicles or reset histories."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare inicio y fin de la misma sesión; no mezcle vehículos ni historiales reiniciados."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同一セッションの開始値と終了値を比較し、別車両やリセット履歴とは混在させないでください。"
          }
        }
      }
    },
    "obd.pid.zd8.21.02.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vehicle Distance"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Distancia del vehículo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "走行距離"
          }
        }
      }
    },
    "obd.pid.zd8.21.02.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ZD8-specific cumulative vehicle distance reported by the engine ECU."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Distancia acumulada específica de ZD8 informada por la ECU del motor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エンジンECUが報告するZD8専用の累積走行距離です。"
          }
        }
      }
    },
    "obd.pid.zd8.21.17.correlation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare with vehicle speed and elapsed driving time under the same ambient and operating conditions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare con velocidad y tiempo de conducción bajo las mismas condiciones ambientales y operativas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ外気・走行条件で車速や走行時間と合わせて比較してください。"
          }
        }
      }
    },
    "obd.pid.zd8.21.17.high": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A high value alone does not identify a fault. Reduce load safely and follow the vehicle manual or professional inspection guidance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un valor alto por sí solo no identifica una falla. Reduzca la carga con seguridad y siga el manual o una inspección profesional."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高値だけで故障とは判断できません。安全に負荷を下げ、車両取扱説明書または専門点検の案内に従ってください。"
          }
        }
      }
    },
    "obd.pid.zd8.21.17.low": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A low value may reflect ambient temperature or warm-up state. Confirm elapsed time and operating conditions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un valor bajo puede reflejar ambiente o calentamiento. Confirme tiempo y condiciones de operación."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "低値は外気温や暖機状態を反映する場合があります。経過時間と走行条件を確認してください。"
          }
        }
      }
    },
    "obd.pid.zd8.21.17.name": {
      "extractionState": "manual",
      "localizations": {
