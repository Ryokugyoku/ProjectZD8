    "device.discovery.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No adapters found. Check that the adapter is powered and Bluetooth is on, then search again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontraron adaptadores. Comprueba que el adaptador esté encendido y que Bluetooth esté activado, y vuelve a buscar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アダプターが見つかりませんでした。アダプターの電源とBluetoothを確認して、再探索してください。"
          }
        }
      }
    },
    "device.discovery.failure.bluetoothPoweredOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth is off. Turn it on to find adapters."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth está desactivado. Actívalo para buscar adaptadores."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetoothがオフです。オンにしてください。"
          }
        }
