    "auth.disclaimer.introduction" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Project ZD8 is a vehicle-data support app developed and provided by an individual. Please confirm the following before use."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Project ZD8 es una aplicación de apoyo para datos del vehículo desarrollada y ofrecida por un particular. Confirma lo siguiente antes de usarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Project ZD8は個人が開発・提供する車両データ支援アプリです。利用前に次の内容を確認してください。"
          }
        }
      }
    },
    "auth.disclaimer.legal_note" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This notice is not legal advice and does not restrict rights granted by applicable law."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este aviso no constituye asesoramiento legal ni limita los derechos reconocidos por la ley aplicable."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この表示は法的助言ではなく、適用法令により認められる権利を制限するものではありません。"
          }
        }
      }
    },
    "auth.disclaimer.liability.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Except for intentional misconduct, gross negligence, or other liability that cannot legally be excluded, the developer is not liable for damage to vehicles, devices, data, property, or persons arising from use."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvo dolo, negligencia grave u otra responsabilidad que la ley no permita excluir, el desarrollador no responde por daños a vehículos, dispositivos, datos, bienes o personas derivados del uso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開発者の故意・重大な過失その他法令上免責できない場合を除き、利用により生じた車両、機器、データ、財産または身体への損害について、開発者は責任を負いません。"
          }
        }
      }
    },
    "auth.disclaimer.liability.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limitation of liability"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limitación de responsabilidad"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "責任の範囲"
          }
        }
      }
    },
    "auth.disclaimer.no_warranty.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Operation, accuracy, fitness, continued availability, data completeness, and compatibility with any vehicle or device are not guaranteed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se garantizan el funcionamiento, la precisión, la idoneidad, la disponibilidad continua, la integridad de los datos ni la compatibilidad con vehículos o dispositivos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動作、正確性、適合性、継続提供、データの完全性、および車両や機器との互換性を保証しません。"
          }
        }
      }
    },
    "auth.disclaimer.no_warranty.title" : {
      "localizations" : {
