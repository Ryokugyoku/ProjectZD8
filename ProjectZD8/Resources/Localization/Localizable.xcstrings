    "account.delete.error" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deletion could not be completed. Your sign-in information was retained so you can retry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo completar la eliminación. Se conservó la información de inicio de sesión para que puedas intentarlo de nuevo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "削除を完了できませんでした。再試行できるようログイン情報は保持されています。"
          }
        }
      }
    },
