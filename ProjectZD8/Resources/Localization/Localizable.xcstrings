    "obd.pid.help.diagnostics.correlation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare voltage, engine speed, speed, DTC/MIL state, warm-ups, and related time or distance items."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare voltaje, régimen, velocidad, DTC/MIL, calentamientos y tiempo/distancia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電圧、回転数、車速、DTC状態、MIL状態、暖機回数、関連する時間・距離項目と比較してください。"
          }
        }
      }
    },
    "obd.pid.help.diagnostics.high": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meaning depends on the item and history. For voltage inspect charging; for time/distance inspect elapsed diagnostic history."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El significado depende del elemento. En voltaje revise carga; en tiempo/distancia revise el historial."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高値の意味は項目と運転履歴に依存します。電源値では充電系、時間・距離では診断発生後の経過を確認してください。"
          }
        }
      }
    },
    "obd.pid.help.diagnostics.low": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meaning depends on the item and history. For voltage inspect battery/wiring; for time/distance inspect recent resets."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El significado depende del elemento. En voltaje revise batería/cableado; en tiempo/distancia revise reinicios."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "低値の意味は項目と運転履歴に依存します。電源値ではバッテリー・配線、時間・距離では直近リセットを確認してください。"
          }
        }
      }
    },
    "obd.pid.help.diagnostics.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Represents operating time, distance, power supply, diagnostic, or encoded state."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Representa tiempo, distancia, alimentación, diagnóstico o estado codificado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "運転時間、距離、電源、診断または複合状態を表します。"
          }
        }
      }
    },
    "obd.pid.help.driving.correlation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare speed, engine speed, load, pedal positions, throttle channels, demanded and actual values."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare velocidad, régimen, carga, pedal, acelerador y valores solicitados/reales."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "車速、回転数、負荷、アクセル位置、スロットル各系統、要求値と実値を比較してください。"
          }
        }
      }
    },
    "obd.pid.help.driving.high": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A high value may be normal for the input; mismatch or sticking can indicate a control or sensor issue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un valor alto puede ser normal; diferencias o bloqueo pueden indicar problema de control o sensor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高値は運転操作に沿う場合がありますが、要求と実位置の差や張り付きは制御系・センサー異常の可能性があります。"
          }
        }
      }
    },
    "obd.pid.help.driving.low": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A low value may be normal for the input; failure to follow demand can indicate an input, actuator, or sensor issue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un valor bajo puede ser normal; no seguir la demanda puede indicar problema de entrada, actuador o sensor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "低値は運転操作に沿う場合がありますが、要求に追従しない場合は入力・アクチュエーター・センサー異常の可能性があります。"
          }
        }
      }
    },
    "obd.pid.help.driving.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Represents vehicle speed, driver input, or actuator position."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Representa velocidad, entrada del conductor o posición del actuador."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "車速または運転者入力とアクチュエーター位置を表します。"
          }
        }
      }
    },
    "obd.pid.help.engine.correlation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare with engine speed, vehicle speed, throttle, air flow, fuel trims, and temperatures."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare con régimen, velocidad, acelerador, flujo de aire, ajustes de combustible y temperaturas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回転数、車速、スロットル、吸気量、燃料補正、各温度と比較してください。"
          }
        }
      }
    },
    "obd.pid.help.engine.high": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A high value for the driving condition can indicate heavy demand or an intake, exhaust, or control issue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un valor alto puede indicar alta demanda o un problema de admisión, escape o control."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "運転条件に対して高い場合は大きな負荷、過剰な要求、吸排気や制御の異常が考えられます。"
          }
        }
      }
    },
    "obd.pid.help.engine.low": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A low value for the driving condition can indicate weak output, misfire, or a sensor/control issue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un valor bajo puede indicar poca potencia, fallo de encendido o problema de sensor/control."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "運転条件に対して低い場合は出力不足、入力不足、失火、センサーや制御の異常が考えられます。"
          }
        }
      }
    },
    "obd.pid.help.engine.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Represents engine load, speed, or ignition operation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Representa carga, régimen o encendido del motor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エンジンの負荷、回転または点火状態を表します。"
          }
        }
      }
    },
    "obd.pid.help.fuelAndAir.correlation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare load, engine speed, throttle, manifold pressure, air flow, fuel trims, and oxygen sensors."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare carga, régimen, acelerador, presión, aire, ajustes y sensores de oxígeno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "負荷、回転数、スロットル、吸気圧・吸気量、燃料補正、酸素センサー相互を比較してください。"
          }
        }
      }
    },
    "obd.pid.help.fuelAndAir.high": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A high value can relate to load, mixture correction, pressure, airflow restriction, injection, or sensor issues."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un valor alto puede relacionarse con carga, mezcla, presión, restricción, inyección o sensor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高値は高負荷、過濃・過薄補正、圧力異常、吸気制限、噴射やセンサー異常の可能性があります。"
          }
        }
      }
    },
    "obd.pid.help.fuelAndAir.low": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A low value can relate to fuel shortage, leaks, low pressure, under-reported airflow, injection, or sensor issues."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un valor bajo puede relacionarse con falta de combustible, fugas, presión, aire, inyección o sensor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "低値は燃料不足、漏れ、圧力不足、吸気計測不足、噴射やセンサー異常の可能性があります。"
          }
        }
      }
    },
    "obd.pid.help.fuelAndAir.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Represents fuel delivery, intake, exhaust, or oxygen-sensor operation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Representa combustible, admisión, escape o sensores de oxígeno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "燃料供給、吸気、排気、酸素センサーの状態を表します。"
          }
        }
      }
    },
    "obd.pid.help.temperature.correlation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare with load, engine speed, speed, air flow, fuel trims, and related temperature sensors."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare con carga, régimen, velocidad, aire, ajustes y otros sensores de temperatura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "負荷、回転数、車速、吸気量、燃料補正、関連する別の温度センサーと比較してください。"
          }
        }
      }
    },
    "obd.pid.help.temperature.high": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A high value can relate to heavy load, insufficient cooling, heat soak, catalyst load, or a sensor issue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un valor alto puede deberse a carga, refrigeración insuficiente, calor o sensor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高値は高負荷、冷却不足、吸気加熱、触媒負荷、またはセンサー異常の可能性があります。"
          }
        }
      }
    },
    "obd.pid.help.temperature.low": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A low value can relate to warm-up state, ambient conditions, thermostat, wiring, or a sensor issue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un valor bajo puede deberse al calentamiento, ambiente, termostato, cableado o sensor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "低値は暖機不足、外気条件、サーモスタット、配線、またはセンサー異常の可能性があります。"
          }
        }
      }
    },
    "obd.pid.help.temperature.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Represents a vehicle temperature sensor or thermal condition."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Representa un sensor de temperatura o condición térmica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "車両の温度センサーまたは熱状態を表します。"
          }
        }
      }
    },
    "obd.pid.help.unconfirmed.correlation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare engine speed, load, temperature, fuel and air values from the same time, together with vehicle-specific service information."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare régimen, carga, temperatura y valores de combustible y aire del mismo momento con la información del vehículo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同時刻の回転数、負荷、温度、燃料・吸気系の値と、車両固有の整備資料を併せて確認してください。"
          }
        }
      }
    },
    "obd.pid.help.unconfirmed.high": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No high-value assessment is made without a verified conversion. Consult service information and vehicle conditions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se evalúan valores altos sin una conversión verificada. Consulte la información de servicio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数値化していないため高値判定は行いません。整備資料と実車条件を確認してください。"
          }
        }
      }
    },
    "obd.pid.help.unconfirmed.low": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No low-value assessment is made without a verified conversion. Consult service information and vehicle conditions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se evalúan valores bajos sin una conversión verificada. Consulte la información de servicio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数値化していないため低値判定は行いません。整備資料と実車条件を確認してください。"
          }
        }
      }
    },
    "obd.pid.help.unconfirmed.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The conversion for this PID is unverified, so raw data is not guessed into a numeric value."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conversión de este PID no está verificada; los datos sin procesar no se convierten por suposición."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このPIDの変換式は未確認です。生データを推測して数値表示しません。"
          }
        }
      }
    },
