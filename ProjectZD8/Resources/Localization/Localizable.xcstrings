    "sync.erase.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes all vehicles, maintenance records, photos, and drive logs from iCloud and this Mac. This can't be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina todos los vehículos, registros de mantenimiento, fotos y registros de conducción de iCloud y de este Mac. No se puede deshacer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud上とこのMacにある車両・整備記録・写真・走行ログをすべて削除します。この操作は取り消せません。"
          }
        }
      }
    },
