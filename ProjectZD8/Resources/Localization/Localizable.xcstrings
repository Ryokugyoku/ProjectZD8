          }
        }
      }
    },
    "analysis.components.subtitle" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only systems backed by recorded PIDs are shown. Values are comparison clues, not standalone fault diagnoses."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se muestran sistemas respaldados por PID. Los valores sirven para comparar, no para diagnosticar por sí solos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取得できたPIDがある系統だけを表示します。値は比較の手掛かりであり、単独で故障を確定するものではありません。"
          }
        }
      }
    },
