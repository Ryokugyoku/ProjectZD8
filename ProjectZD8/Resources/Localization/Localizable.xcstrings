    "garage.delete.message %@ %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This deletes “%1$@” and its %2$lld session(s), raw data, maintenance records, and photos from every synced device. This can't be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminará «%1$@» y sus %2$lld sesión(es), datos sin procesar, registros de mantenimiento y fotos de todos los dispositivos sincronizados. No se puede deshacer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」と、紐づく %2$lld 件のセッション・Raw・整備記録・写真を、同期している全端末から削除します。この操作は取り消せません。"
          }
        }
      }
    },
