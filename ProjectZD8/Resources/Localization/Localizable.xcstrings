    "auth.disclaimer.safety.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do not operate the app while driving. Follow vehicle and device manuals, and never use the app as the sole basis for safety decisions or fault diagnosis."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No uses la aplicación mientras conduces. Sigue los manuales del vehículo y del dispositivo y no la uses como única base para decisiones de seguridad o diagnósticos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "運転中は操作しないでください。車両・機器の説明書に従い、本アプリを安全判断や故障診断の唯一の根拠にしないでください。"
          }
        }
      }
