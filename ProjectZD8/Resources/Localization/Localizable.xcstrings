            "value" : "PIDの組み合わせ"
          }
        }
      }
    },
    "analysis.relationship.subtitle" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pairs use the nearest observations within three seconds; this is not proof of causation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los pares usan las observaciones más cercanas dentro de tres segundos; no demuestran causalidad."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3秒以内で最も近い観測を対応付けます。因果関係を示すものではありません。"
          }
        }
      }
    },
    "analysis.relationship.title" : {
