    "account.delete.warning.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleting your account permanently removes all acquired driving data from your devices and CloudKit, along with app settings and saved sign-in information. This action cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al eliminar tu cuenta se borrarán permanentemente todos los datos de conducción adquiridos de tus dispositivos y CloudKit, además de la configuración de la app y la información de inicio de sesión. Esta acción no se puede deshacer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントを削除すると、各端末とCloudKitに保存されたすべての取得済み運転データ、アプリ設定、ログイン情報が完全に削除されます。この操作は取り消せません。"
          }
        }
      }
    },
