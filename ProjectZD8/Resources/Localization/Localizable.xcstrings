    "analysis.download.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This session's raw log is stored only in iCloud. It has to be downloaded before it can be analyzed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El registro de esta sesión solo está en iCloud. Hay que descargarlo para analizarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このセッションのRawログはiCloudにだけ保存されています。分析するにはダウンロードが必要です。"
          }
        }
      }
    },
    "analysis.download.title": {
      "extractionState": "manual",
      "localizations": {
