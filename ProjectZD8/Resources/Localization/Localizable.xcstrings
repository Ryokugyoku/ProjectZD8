    "analysis.relationship.empty.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A scatter plot appears when a supported PID pair has at least two observations within three seconds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El diagrama aparece cuando un par PID compatible tiene al menos dos observaciones con una diferencia máxima de tres segundos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "対応するPID組に3秒以内の観測が2点以上あると表示されます。"
          }
        }
      }
    },
    "analysis.relationship.empty.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No relationship available"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay relación disponible"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "表示できる相関がありません"
          }
        }
      }
    },
    "analysis.relationship.guide.common" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a PID pair, then look at the spread and clusters of dots. Each dot combines the nearest observations within three seconds; use the chart to compare operating patterns, not to prove causation or diagnose a fault by itself."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un par de PID y observa la dispersión y los grupos de puntos. Cada punto combina las observaciones más cercanas en un intervalo de tres segundos; usa el gráfico para comparar patrones de funcionamiento, no para demostrar causalidad ni diagnosticar una avería por sí solo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIDの組を選び、点の広がりやまとまりを見ます。各点は3秒以内で最も近い観測同士を組み合わせたものです。運転状態の傾向比較に使い、因果関係の証明や単独での故障診断には使用しません。"
          }
        }
      }
    },
    "analysis.relationship.guide.rpm_load" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engine speed × calculated load shows which speed and relative-load regions were used. Compare dense regions and outliers between sessions to understand operating-range differences."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Régimen del motor × carga calculada muestra qué regiones de régimen y carga relativa se utilizaron. Compara las zonas densas y los valores atípicos entre sesiones para entender las diferencias de funcionamiento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エンジン回転数 × 算出負荷は、どの回転域・相対負荷域を使ったかを見る組です。点が集中する領域や外れ方をセッション間で比較し、運転領域の違いを把握できます。"
          }
        }
      }
    },
    "analysis.relationship.guide.rpm_maf" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engine speed × mass air flow shows how measured intake-air mass changed across engine speeds. Use changes in the curve or unusual clusters as comparison clues while accounting for load and driving conditions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Régimen del motor × caudal de aire muestra cómo cambió la masa de aire de admisión medida según el régimen. Usa los cambios de la curva o grupos inusuales como pistas comparativas, teniendo en cuenta la carga y las condiciones de conducción."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エンジン回転数 × 吸入空気量は、回転域に対して実測吸入空気質量がどう変化したかを見る組です。負荷や走行条件も考慮し、曲線の変化や不自然なまとまりを比較の手掛かりにします。"
          }
        }
      }
    },
    "analysis.relationship.guide.rpm_speed" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engine speed × vehicle speed makes operating ranges, stops, acceleration, and possible shift-related changes easier to see. Compare the shape between similar routes; the plot does not identify a gear by itself."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Régimen del motor × velocidad del vehículo facilita ver rangos de uso, paradas, aceleraciones y posibles cambios relacionados con las marchas. Compara la forma entre rutas similares; el gráfico no identifica una marcha por sí solo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エンジン回転数 × 車速は、使用回転域、停車、加速、変速に伴う可能性のある変化を見やすくする組です。似た経路同士で形を比較しますが、この図だけでギア段を特定することはできません。"
          }
        }
      }
    },
    "analysis.relationship.guide.speed_zd8_atf" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vehicle speed × ZD8 AT fluid temperature helps compare transmission temperature changes with driving load. It is observational data, not a diagnostic threshold."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velocidad × temperatura ATF ZD8 permite comparar cambios térmicos con carga de conducción. Es observación, no umbral diagnóstico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "車速 × ZD8 AT油温は、走行負荷に伴う変速機温度の変化を比較するための観察値です。診断しきい値ではありません。"
          }
        }
      }
    },
    "analysis.relationship.guide.throttle_load" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Throttle position × calculated load compares throttle opening with relative engine load. Look for response shape, lag-like spread, and session-to-session differences; throttle position is not always the accelerator-pedal position."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posición de la mariposa × carga calculada compara la apertura de la mariposa con la carga relativa del motor. Observa la forma de respuesta, la dispersión similar a un retraso y las diferencias entre sesiones; la posición de la mariposa no siempre equivale a la del pedal."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スロットル開度 × 算出負荷は、スロットル開度と相対的なエンジン負荷を比較する組です。応答の形、遅れに見える広がり、セッション間の違いを見ます。スロットル開度はアクセルペダル位置と同一とは限りません。"
          }
        }
      }
    },
    "analysis.relationship.guide.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How to use this scatter plot"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cómo usar este diagrama de dispersión"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この散布図の見方"
          }
        }
      }
    },
    "analysis.relationship.guide.trim_banks" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Short-term fuel trim Bank 1 × Bank 2 compares simultaneous correction tendencies between banks. A balanced cluster or persistent offset can guide comparison, but supported bank layout and other conditions must be confirmed before diagnosis."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuste de combustible a corto plazo Banco 1 × Banco 2 compara las tendencias de corrección simultáneas. Un grupo equilibrado o un desplazamiento persistente orienta la comparación, pero deben confirmarse la disposición de bancos y otras condiciones antes de diagnosticar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "短期燃料補正 Bank 1 × Bank 2は、両バンクの同時期の補正傾向を比べる組です。均衡したまとまりや継続的な偏りを比較の手掛かりにできますが、診断前に車両のバンク構成と他条件の確認が必要です。"
          }
        }
      }
    },
    "analysis.relationship.pair" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PID pair"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Par de PID"
          }
        },
        "ja" : {
