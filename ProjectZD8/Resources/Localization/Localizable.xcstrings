    "history.raw.remove.safe.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The raw log is stored in iCloud. Remove %lld raw records (%@) from this device? Nothing is deleted from iCloud; the session remains and the raw log downloads again when needed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El registro raw está guardado en iCloud. ¿Eliminar %lld registros raw (%@) de este dispositivo? No se elimina nada de iCloud; la sesión se conserva y los datos se descargarán de nuevo cuando sean necesarios."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RawログはiCloudに保管済みです。この端末から%lld件（%@）を取り除きますか？iCloudからは削除せず、セッション履歴は残り、必要時に再ダウンロードします。"
          }
        }
      }
    },
