    },
    "auth.disclaimer.risk.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use of this app, selection and connection of devices, and decisions based on acquired data are undertaken at your own judgment and risk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El uso de la aplicación, la elección y conexión de dispositivos y las decisiones basadas en los datos obtenidos se realizan bajo tu propio criterio y riesgo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本アプリの利用、接続機器の選定・接続、および取得データに基づく判断は、利用者自身の判断と責任で行ってください。"
          }
        }
      }
