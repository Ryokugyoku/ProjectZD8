    },
    "device.discovery.failure.bluetoothUnauthorized": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth access isn't allowed. Allow it in Settings."
