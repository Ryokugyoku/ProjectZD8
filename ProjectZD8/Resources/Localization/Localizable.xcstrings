    "account.delete.card.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permanently remove this account's app settings and saved sign-in information."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina permanentemente la configuración de la app y la información de inicio de sesión guardada de esta cuenta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアカウントのアプリ設定と保存済みログイン情報を完全に削除します。"
          }
        }
      }
    },
    "account.delete.card.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete account"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminar cuenta"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントを削除"
          }
        }
      }
    },
