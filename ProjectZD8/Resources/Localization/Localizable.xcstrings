    "analysis.components.diagnostics.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PID 31 is distance since codes were cleared; PID 21 is distance with the MIL on. They do not identify a clear date or fault cause and depend on ECU behavior."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El PID 31 es distancia desde el borrado y el 21 distancia con MIL. No identifican fecha ni causa y dependen de la ECU."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PID 31は故障コード消去後、PID 21はMIL点灯中の累積距離です。消去日時や原因は特定できず、ECUの挙動にも依存します。"
          }
        }
      }
    },
    "analysis.components.diagnostics.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diagnostic distance history"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Historial de distancia de diagnóstico"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "診断距離履歴"
          }
        }
      }
    },
    "analysis.components.electrical.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ECU supply voltage can be compared across rpm and electrical load. It is not a direct alternator-output measurement or a standalone diagnosis."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El voltaje visto por la ECU puede compararse con rpm y carga eléctrica. No mide directamente el alternador ni lo diagnostica por sí solo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ECUが見ている電圧を回転数や電装負荷と比較できます。オルタネータ出力の直接測定ではなく、単独診断もできません。"
          }
        }
      }
    },
    "analysis.components.electrical.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Charging and electrical"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carga y sistema eléctrico"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "充電・電源系"
          }
        }
      }
    },
    "analysis.components.empty" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No recorded PID can be linked to a supported vehicle system."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ningún PID registrado puede vincularse a un sistema compatible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "対応している部品・系統へ結び付けられるPIDがありません。"
          }
        }
      }
    },
    "analysis.components.exhaust.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catalyst or DPF temperature shows thermal history. Temperature alone does not establish soot loading, regeneration success, or component health."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La temperatura muestra historial térmico. Por sí sola no determina hollín, regeneración ni estado del componente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "触媒・DPF温度から熱履歴を見ます。温度だけでは煤量、再生成否、部品健全性を確定できません。"
          }
        }
      }
    },
    "analysis.components.exhaust.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exhaust aftertreatment"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postratamiento de escape"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "排気後処理系"
          }
        }
      }
    },
    "analysis.components.fuel_intake.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fuel trims and airflow help compare mixture correction and intake demand. Interpret them with load, rpm, temperature, leaks, and service data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los ajustes y el caudal ayudan a comparar mezcla y admisión. Interprételos con carga, rpm, temperatura y datos de servicio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "燃料補正と吸入空気量から混合気補正や吸気需要を比較します。負荷、回転数、温度、漏れ、整備情報も必要です。"
          }
        }
      }
    },
    "analysis.components.fuel_intake.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fuel and intake"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combustible y admisión"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "燃料・吸気系"
          }
        }
      }
    },
    "analysis.components.statistics" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Latest %1$.1f / Min %2$.1f / Avg %3$.1f / Max %4$.1f %5$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Últ. %1$.1f / Mín. %2$.1f / Prom. %3$.1f / Máx. %4$.1f %5$@"
          }
        },
        "ja" : {
          "stringUnit" : {
