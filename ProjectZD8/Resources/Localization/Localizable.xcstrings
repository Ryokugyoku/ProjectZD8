    "analysis.overview.rpm_ranking_note" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ranks 500 rpm ranges. Low rpm alone does not prove sludge risk; engine type, load, oil temperature, oil specification, trip length, and maintenance also matter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clasifica rangos de 500 rpm. Bajas rpm no demuestran lodos; importan motor, carga, aceite, trayecto y mantenimiento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "500 rpm単位で順位化します。低回転が多いだけではスラッジリスクを確定できず、形式、負荷、油温、オイル規格、走行時間、整備履歴も必要です。"
          }
        }
      }
    },
